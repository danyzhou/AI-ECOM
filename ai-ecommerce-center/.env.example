# AI Ecommerce Operation Center Environment Configuration

# Domain & Application Settings
DOMAIN_NAME=ai.yourdomain.com
PORT=3000
NODE_ENV=production

# PostgreSQL Database Configuration
POSTGRES_DB=ai_ecommerce
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=generate_a_secure_password_here
DATABASE_URL=postgresql://ai_admin:generate_a_secure_password_here@postgres:5432/ai_ecommerce

# Admin Account Initial Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=generate_admin_password

# System Security Secrets
JWT_SECRET=generate_random_jwt_secret_key_here

# AI Provider Credentials (Optional on setup, editable in web UI)
OPENAI_API_KEY=
GEMINI_API_KEY=
