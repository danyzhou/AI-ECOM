# System Environment Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql://ai_admin:your_postgres_password@localhost:5432/ai_ecommerce
POSTGRES_DB=ai_ecommerce
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=your_postgres_password

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
SESSION_SECRET=your_session_secret_key_change_in_production

# AI Provider API Keys (Gemini as Sole Provider)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Initial Admin Credentials
ADMIN_EMAIL=admin@ecom-ai.com
ADMIN_PASSWORD=admin123
